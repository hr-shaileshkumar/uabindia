{
  "key": "purchase_approval",
  "name": "Purchase Request Approval (future-proofed)",
  "version": "1.0.0",
  "description": "Purchase approval with configurable thresholds and multiple approver paths",
  "variables": {
    "requestId": "guid",
    "requesterId": "guid",
    "amount": "number",
    "currency": "string",
    "companyId": "guid",
    "category": "string"
  },
  "steps": [
    { "key": "create_request", "name": "Create Purchase Request", "type": "start" },
    { "key": "manager_approval", "name": "Manager Approval", "type": "approval", "roleRequired": "Manager", "assigneeExpression": "requester.managerId", "slaHours": 48 },
    { "key": "procurement_approval", "name": "Procurement Approval", "type": "approval", "roleRequired": "Procurement" },
    { "key": "finance_approval", "name": "Finance Approval", "type": "approval", "roleRequired": "FinanceManager" },
    { "key": "create_po", "name": "Create PO (automated/manual)", "type": "task", "metadata": { "allowManual": true } },
    { "key": "completed", "name": "Completed", "type": "end" }
  ],
  "transitions": [
    { "from": "create_request", "to": "manager_approval", "action": "submit" },
    { "from": "manager_approval", "to": "procurement_approval", "action": "approve", "condition": { "<=": [ {"var":"amount"}, 50000 ] } },
    { "from": "manager_approval", "to": "finance_approval", "action": "approve", "condition": { ">": [ {"var":"amount"}, 50000 ] } },
    { "from": "procurement_approval", "to": "finance_approval", "action": "approve" },
    { "from": "finance_approval", "to": "create_po", "action": "approve" },
    { "from": "create_po", "to": "completed", "action": "complete" },
    { "from": "manager_approval", "to": "completed", "action": "reject", "condition": true },
    { "from": "procurement_approval", "to": "completed", "action": "reject", "condition": true },
    { "from": "finance_approval", "to": "completed", "action": "reject", "condition": true }
  ],
  "events": ["purchase.requested","purchase.approved","purchase.ordered"]
}
