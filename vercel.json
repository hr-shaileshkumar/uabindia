{
  "buildCommand": "npm --prefix frontend run build",
  "devCommand": "npm --prefix frontend run dev",
  "installCommand": "npm --prefix frontend install --legacy-peer-deps",
  "framework": "nextjs",
  "outputDirectory": "frontend/.next",
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.uabindia.in",
    "NEXT_PUBLIC_APP_VERSION": "1.0.0"
  },
  "regions": ["iad1"],
  "functions": {
    "api/**/*.{js,ts}": {
      "maxDuration": 30
    }
  }
}
