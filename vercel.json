{
  "buildCommand": "cd frontend && npm install --legacy-peer-deps --no-workspaces && npm run build",
  "devCommand": "cd frontend && npm run dev",
  "installCommand": "cd frontend && npm install --legacy-peer-deps --no-workspaces",
  "framework": "nextjs",
  "outputDirectory": "frontend/.next",
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.uabindia.in",
    "NEXT_PUBLIC_APP_VERSION": "1.0.0"
  },
  "regions": ["iad1"],
  "functions": {
    "api/**/*.{js,ts}": {
      "maxDuration": 30
    }
  }
}
