{
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "postinstall": "npm install --legacy-peer-deps --prefix frontend --no-workspaces",
    "dev": "npm --prefix frontend run dev",
    "build": "npm install --legacy-peer-deps --prefix frontend --no-workspaces && npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint"
  }
}
