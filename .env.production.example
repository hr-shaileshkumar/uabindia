# ==============================================================================
# UabIndia ERP SaaS - Production Deployment Environment Template
# IMPORTANT: Never commit actual production credentials or secret keys to source control.
# ==============================================================================

# --- Server & Environment ---
ASPNETCORE_ENVIRONMENT=Production
PORT=5000
NODE_ENV=production

# --- Database Connection (SQL Server Enterprise / Azure SQL) ---
ConnectionStrings__DefaultConnection=Server=tcp:sql-uabindia-prod.database.windows.net,1433;Initial Catalog=uabindia_erp_db;Persist Security Info=False;User ID=uabadmin;Password=YOUR_SECURE_COMPLEX_PASSWORD_HERE;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# --- Authentication & JWT Security ---
# Generate a strong 256-bit key (at least 64 random characters)
Jwt__Secret=CHANGE_THIS_TO_YOUR_SECURE_256_BIT_RANDOM_JWT_SECRET_KEY_MIN_64_CHARS
Jwt__Issuer=https://api.uabindia.in
Jwt__Audience=https://uabindia.in
Jwt__ExpiryMinutes=60
Jwt__RefreshTokenExpiryDays=7

# --- Redis Cache Cluster (Multi-Node Scaling) ---
Redis__ConnectionString=redis-prod.uabindia.internal:6379,password=YOUR_REDIS_PASSWORD,ssl=True,abortConnect=False

# --- Hangfire Background Processing ---
Hangfire__DashboardPath=/hangfire
Hangfire__RequireAdmin=true

# --- Application Insights / Sentry Error Monitoring ---
ApplicationInsights__ConnectionString=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://eastus-0.in.applicationinsights.azure.com/
Sentry__Dsn=https://your-sentry-dsn-here@o0.ingest.sentry.io/0

# --- Email & Communication Service (SendGrid / AWS SES) ---
Email__SmtpHost=smtp.sendgrid.net
Email__SmtpPort=587
Email__SmtpUser=apikey
Email__SmtpPassword=YOUR_SENDGRID_API_KEY_HERE
Email__FromEmail=noreply@uabindia.in
Email__FromName=UabIndia ERP Platform

# --- WhatsApp Business Cloud API ---
WhatsApp__ApiUrl=https://graph.facebook.com/v18.0
WhatsApp__PhoneNumberId=YOUR_WHATSAPP_PHONE_NUMBER_ID
WhatsApp__AccessToken=YOUR_META_WHATSAPP_PERMANENT_ACCESS_TOKEN
