# ==============================================================================
# UabIndia ERP SaaS - Production Deployment Environment Template
# IMPORTANT: Never commit actual production credentials or secret keys to source control.
#
# NOTE ON HOST CPU ARCHITECTURE:
# The SQL Server 2022 container (mcr.microsoft.com/mssql/server:2022-latest) requires
# an x86_64 (AMD64) host CPU architecture. ARM64 hosts (e.g., AWS Graviton, Apple Silicon)
# are NOT supported natively by Microsoft SQL Server Linux containers.
# ==============================================================================

# --- Docker Compose Mandatory Variables (docker-compose.prod.yml) ---
# Database root/sa password (min 8 chars, uppercase, lowercase, numbers, symbols)
DB_PASSWORD=YOUR_COMPLEX_SQL_SERVER_PASSWORD_MIN_16_CHARS

# Redis authentication password
REDIS_PASSWORD=YOUR_COMPLEX_REDIS_PASSWORD_MIN_32_CHARS

# JWT Signing Key (HMAC-SHA256: at least 64 characters / 512 bits)
JWT_KEY=YOUR_SECURE_512_BIT_RANDOM_JWT_SECRET_KEY_MIN_64_CHARS

# Initial SuperAdmin provisioning password (required in production; startup will halt if missing)
SEED_ADMIN_PASSWORD=YOUR_COMPLEX_INITIAL_SUPERADMIN_PASSWORD_MIN_16_CHARS
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_NAME=Enterprise SuperAdmin

# --- Server & Environment ---
ASPNETCORE_ENVIRONMENT=Production
PORT=5000
NODE_ENV=production

# --- Database Connection (SQL Server Enterprise / Azure SQL) ---
ConnectionStrings__DefaultConnection=Server=tcp:sql-uabindia-prod.database.windows.net,1433;Initial Catalog=uabindia_erp_db;Persist Security Info=False;User ID=uabadmin;Password=YOUR_SECURE_COMPLEX_PASSWORD_HERE;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# --- Authentication & JWT Security ---
# Generate a strong 512-bit key (at least 64 random characters)
Jwt__Secret=CHANGE_THIS_TO_YOUR_SECURE_512_BIT_RANDOM_JWT_SECRET_KEY_MIN_64_CHARS
Jwt__Issuer=https://api.uabindia.in
Jwt__Audience=https://uabindia.in
Jwt__ExpiryMinutes=60
Jwt__RefreshTokenExpiryDays=7

# --- AES-256-GCM Column-Level PII Encryption & Blind Index HMAC ---
Encryption__MasterKey=CHANGE_THIS_TO_YOUR_SECURE_256_BIT_AES_GCM_BASE64_KEY_32_BYTES
Encryption__HmacKey=CHANGE_THIS_TO_YOUR_SECURE_256_BIT_HMAC_SHA256_BASE64_KEY_32_BYTES

# --- Redis Cache Cluster (Multi-Node Scaling) ---
Redis__ConnectionString=redis-prod.uabindia.internal:6379,password=YOUR_REDIS_PASSWORD,ssl=True,abortConnect=False

# --- Hangfire Background Processing ---
Hangfire__DashboardPath=/hangfire
Hangfire__RequireAdmin=true

# --- Application Insights / Sentry Error Monitoring ---
ApplicationInsights__ConnectionString=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://eastus-0.in.applicationinsights.azure.com/
Sentry__Dsn=https://your-sentry-dsn-here@o0.ingest.sentry.io/0

# --- Email & Communication Service (SendGrid / AWS SES) ---
Email__SmtpHost=smtp.sendgrid.net
Email__SmtpPort=587
Email__SmtpUser=apikey
Email__SmtpPassword=YOUR_SENDGRID_API_KEY_HERE
Email__FromEmail=noreply@uabindia.in
Email__FromName=UabIndia ERP Platform

# --- WhatsApp Business Cloud API ---
WhatsApp__ApiUrl=https://graph.facebook.com/v18.0
WhatsApp__PhoneNumberId=YOUR_WHATSAPP_PHONE_NUMBER_ID
WhatsApp__AccessToken=YOUR_META_WHATSAPP_PERMANENT_ACCESS_TOKEN

# --- Payment Gateways (SaaS Subscriptions & Customer Billing) ---
Razorpay__KeyId=rzp_live_YOUR_RAZORPAY_KEY_ID
Razorpay__KeySecret=YOUR_RAZORPAY_KEY_SECRET
Razorpay__WebhookSecret=YOUR_RAZORPAY_WEBHOOK_SECRET
Stripe__PublishableKey=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
Stripe__SecretKey=sk_live_YOUR_STRIPE_SECRET_KEY
Stripe__WebhookSecret=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# --- Indian GST & NIC E-Invoicing Credentials ---
EInvoice__GspUrl=https://einv-apisandbox.nic.in
EInvoice__ClientId=YOUR_NIC_EINV_CLIENT_ID
EInvoice__ClientSecret=YOUR_NIC_EINV_CLIENT_SECRET
EInvoice__Gstin=07AABCU9603R1ZM
