# HRMS / ERP monorepo .gitignore
# .NET Backend + Next.js Frontend + Expo Mobile + CI artifacts

########################################################
# Visual Studio / .NET
########################################################
.vs/
**/bin/
**/obj/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
packages/
project.lock.json
**/project.assets.json

########################################################
# IDEs
########################################################
.idea/
*.iml

# VS Code - keep useful team settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

########################################################
# Node / Frontend
########################################################
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.pnp.*

# Build outputs
dist/
.vite/
.next/
out/
build/
public/build/

########################################################
# Expo / React Native / Mobile
########################################################
.expo/
.expo-shared/
android/.gradle/
android/**/build/
android/app/build/
ios/Pods/
ios/build/
.gradle/
*.keystore
*.jks

########################################################
# Logs, coverage and test results
########################################################
logs/
*.log
install-errors.txt
TestResults/
coverage/
coverage-final.json
*.coverage
*.coveragexml

########################################################
# Environment & secrets
########################################################
.venv/
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
secrets.*
*.pem
*.pfx
*.key
/.secret
appsettings.Development.local.json
appsettings.*.local.json
**/appsettings.Development.json

# Keep example env and dev template (no real credentials)
!/.env.example
!**/appsettings.Development.json.example
!Backend/deploy/*.example

# Real VPS env files copied from the examples above
Backend/deploy/uabindia_api.env
Backend/deploy/uabindia_api.env.staging

########################################################
# OS artifacts
########################################################
.DS_Store
Thumbs.db
desktop.ini

########################################################
# Docker / local infra
########################################################
docker-compose.override.yml
docker-compose.*.local.yml

########################################################
# Cache
########################################################
.cache/
.eslintcache
.stylelintcache
.turbo/
.parcel-cache/
.sass-cache

########################################################
# Temporary / generated folders
########################################################
temp/
tmp/
scratch/
backup/
archive/
!Backend/migrations_scripts/archive/
!Backend/migrations_scripts/archive/**
artifacts/
screenshots/
recordings/

########################################################
# Generated reports / old audit docs
########################################################
*_REPORT*.md
*_SUMMARY*.md
*_PLAN*.md
*_AUDIT*.md
*_TRACKER*.md
*_FIX*.md

########################################################
# Generated files / backups
########################################################
*.zip
*.7z
*.rar
*.bak
*.backup
*.db
*.sqlite
*.sqlite3
*.orig
*.rej

########################################################
# Generated certificates, keys and build outputs
########################################################
certs/
*.crt
*.cer

########################################################
# GitHub Actions artifacts
########################################################
*.workflow-cache
actions-runner/

########################################################
# Local tools / AI editors
########################################################
.cursor/
.claude/
.ai/
.codex/
.antigravity/
.continue/
.kiro/

# Local utility binaries / local packaging artifacts
ngrok.exe
ngrok.zip
backend_deployment.zip

# Publish output: build artifacts, and it also carried a committed copy of
# appsettings.Development.json with real credentials.
Backend/publish/
Backend/_build_*/
Backend/artifacts-startup-check/
_testbuild/
_testbuild2/

########################################################
# Keep migration SQL artifacts tracked
########################################################
# Backend/migrations_scripts/* should be committed
cleanup-backup-*/
