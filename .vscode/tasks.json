			],
			"isBackground": false
		},
		{
			"label": "frontend-install-test-deps-noaudit",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"install",
				"--no-audit",
				"--no-fund"
			],
			"isBackground": false
		},
		{
			"label": "frontend-clean-reinstall",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Remove-Item -Recurse -Force frontend/node_modules; Remove-Item -Force frontend/package-lock.json; npm --prefix frontend install --no-audit --no-fund"
			],
			"isBackground": false
		},
		{
			"label": "inspect-node-process-locks",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Get-CimInstance Win32_Process -Filter \"Name = 'node.exe'\" | Select-Object ProcessId, CommandLine | Format-List"
			],
			"isBackground": false
		},
		{
			"label": "inspect-node-process-locks-wmic",
			"type": "shell",
			"command": "wmic",
			"args": [
				"process",
				"where",
				"name='node.exe'",
				"get",
				"ProcessId,CommandLine",
				"/format:list"
			],
			"isBackground": false
		},
		{
			"label": "stop-node-processes",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"Get-Process node -ErrorAction SilentlyContinue | Stop-Process -Force"
			],
			"isBackground": false
		},
		{
			"label": "frontend-clean-reinstall-2",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"if (Test-Path frontend/node_modules) { Remove-Item -Recurse -Force frontend/node_modules }; if (Test-Path frontend/package-lock.json) { Remove-Item -Force frontend/package-lock.json }; npm --prefix frontend install --no-audit --no-fund"
			],
			"isBackground": false
		},
		{
			"label": "frontend-install-after-clean",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"install",
				"--no-audit",
