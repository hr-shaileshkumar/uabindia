{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-backend-api",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"Backend/src/UabIndia.Api/UabIndia.Api.csproj",
				"-c",
				"Release"
			],
			"problemMatcher": ["$msCompile"],
			"group": "build"
		},
		{
			"label": "frontend-typecheck",
			"type": "shell",
			"command": "npm",
			"args": ["--prefix", "frontend", "run", "typecheck"],
			"problemMatcher": ["$tsc"],
			"group": "build"
		},
		{
			"label": "frontend-lint",
			"type": "shell",
			"command": "npm",
			"args": ["--prefix", "frontend", "run", "lint"],
			"problemMatcher": ["$eslint-stylish"],
			"group": "build"
		},
		{
			"label": "frontend-build",
			"type": "shell",
			"command": "npm",
			"args": ["--prefix", "frontend", "run", "build"],
			"problemMatcher": ["$tsc"],
			"group": "build"
		}
	]
}
