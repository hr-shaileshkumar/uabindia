{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "typecheck",
			"type": "shell",
			"command": "npm",
			"args": ["run", "typecheck"],
			"problemMatcher": ["$tsc"],
			"group": "build"
		},
		{
			"label": "lint",
			"type": "shell",
			"command": "npm",
			"args": ["run", "lint"],
			"problemMatcher": ["$eslint-stylish"],
			"group": "build"
		},
		{
			"label": "build",
			"type": "shell",
			"command": "npm",
			"args": ["run", "build"],
			"problemMatcher": ["$tsc"],
			"group": "build"
		}
	]
}
