# Example environment variables for local development
# Copy this file to `.env` and replace values with secrets

# JWT settings (required)
Jwt__Key=REPLACE_WITH_STRONG_SECRET
Jwt__Issuer=UabIndia
Jwt__Audience=UabIndiaUsers

# Encryption key for PII protection (required outside local dev)
Encryption__Key=REPLACE_WITH_STRONG_ENCRYPTION_KEY

# Database connection (example for local SQL Server)
ConnectionStrings__DefaultConnection=Server=localhost;Database=UabIndiaDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;

# Frontend/backend routing
# Client requests use the frontend /api proxy automatically.
# Set one of these on the frontend host per environment:
API_BASE_URL=http://localhost:5000
# BACKEND_INTERNAL_URL=http://localhost:5000
# NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: default tenant used by public website endpoints when the root host
# does not provide an explicit tenant context. The development seed uses `api`.
# PublicSite__DefaultTenantSubdomain=api

# ASP.NET environment
ASPNETCORE_ENVIRONMENT=Development

# Backend CORS origins for stage/prod without code changes
Cors__AllowedOriginsCsv=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Optional: port binding for the helper runner / Docker
PORT=5000
