# Copy this file to uabindia_api.env on the VPS (never commit real secrets).
# Used by scripts/deploy_to_vps.sh when present.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000
ConnectionStrings__DefaultConnection=Server=YOUR_SQL_SERVER;Database=UabIndia_HRMS;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=true
Jwt__Key=REPLACE_WITH_STRONG_JWT_KEY_MIN_64_CHARS
Jwt__Issuer=https://api.uabindia.in
Jwt__Audience=uabindia_clients
Encryption__Key=REPLACE_WITH_32_CHAR_ENCRYPTION_KEY
Cors__AllowedOrigins=https://app.uabindia.in
