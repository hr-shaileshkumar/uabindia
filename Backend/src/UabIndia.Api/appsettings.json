    "Audience": "uabindia_clients"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.uabindia.in",
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:3001",
      "http://127.0.0.1:5173"
    ]
  },
  "Encryption": {
    "Key": "dev-only-change-this-to-a-strong-secret-key-min-32-chars"
  },
  "TenantProvisioning": {
    "TemplateSchema": "dbo",
    "RoleMappings": {
      "DefaultAdminRole": "ADMIN",
      "AllowedAdminRoles": [ "ADMIN", "SUPER_ADMIN" ],
      "DefaultEmployeeRole": "EMPLOYEE",
      "AllowedEmployeeRoles": [ "EMPLOYEE" ]
    },
    "TemplateGovernance": {
      "TemplateVersion": "v1",
      "TemplateChecksum": "",
      "EnforceChecksum": false
    }
